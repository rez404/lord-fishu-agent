# ---- runtime ----
NODE_ENV=development
LOG_LEVEL=debug

# Master safety flags.
# DRY_RUN=true  -> the agent decides and logs everything, but never calls a write endpoint.
# KILL_SWITCH=true -> the agent halts all action (reads included). Also togglable at runtime in DB.
DRY_RUN=true
KILL_SWITCH=false

# ---- infra ----
DATABASE_URL=postgres://fishnu:fishnu@localhost:5433/fishnu
REDIS_URL=redis://localhost:6380

# ---- X API v2 (Basic tier) ----
# OAuth 1.0a user context is required for posting.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# OAuth2 app-only bearer, used for read endpoints where it is cheaper/allowed.
X_BEARER_TOKEN=
X_USER_ID=
X_USERNAME=

# ---- quota budget (VERIFY against your actual X plan before going live) ----
QUOTA_MONTHLY_READS=15000
QUOTA_MONTHLY_WRITES=3000
QUOTA_DAILY_READS=500
QUOTA_DAILY_WRITES=100

# ---- api (read model consumed by the Next.js terminal) ----
API_PORT=8081
# Every browser origin allowed to hit the API. The Vercel production domain plus, if you
# want preview deploys to work, the *.vercel.app preview domain.
CORS_ORIGINS=http://localhost:3000

# ---- engagement policy ----
# Only accounts at or above this follower count get a reply. Below it, mentions are
# parked as 'skipped_low_reach' — kept, not discarded, so lowering the bar later can
# requeue them (pnpm --filter @fishnu/agent requeue <threshold>).
# Overridable at runtime via the `reply_min_followers` row in the settings table.
REPLY_MIN_FOLLOWERS=1000

# ---- loop cadence ----
TICK_INTERVAL_MS=300000
TICK_JITTER_MS=90000
SLEEP_WINDOW_UTC=03:00-09:00
