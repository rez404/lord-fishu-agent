# Copy to deploy/.env on the server. This file holds the X write keys — chmod 600 it.

# ---- domain ----
# Point an A record at the box first. Caddy takes a certificate for exactly this name.
API_DOMAIN=api.lordfishnu.xyz

# ---- database ----
POSTGRES_USER=fishnu
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=fishnu

# ---- browser origins allowed to call the api ----
# The Vercel production domain. Add *.vercel.app only if preview deploys need to work.
# Operator console at /admin. Unset disables those routes entirely — an unauthenticated
# kill switch on a public URL is worse than no kill switch. Generate with:
#   openssl rand -hex 32
ADMIN_TOKEN=

CORS_ORIGINS=https://lordfishnu.xyz,https://www.lordfishnu.xyz

# ---- safety ----
# Leave DRY_RUN=true until the persona is calibrated. Nothing is posted while it is on.
DRY_RUN=true
KILL_SWITCH=false

# ---- X API v2 ----
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USER_ID=
X_USERNAME=lordfishnu

# ---- quota (verify against the actual X plan) ----
QUOTA_MONTHLY_READS=15000
QUOTA_MONTHLY_WRITES=3000
QUOTA_DAILY_READS=500
QUOTA_DAILY_WRITES=100

# ---- engagement ----
REPLY_MIN_FOLLOWERS=1000

# ---- unprompted posting ----
# How many posts a day. Scattered at random inside the waking window (everything is UTC),
# never evenly spaced, and the plan is written to the database so a restart cannot re-roll
# it and post four times in ten minutes.
POSTS_PER_DAY=6

# ---- the nightly backrooms ----
# Turns in the unsupervised nightly conversation between the two instances. 0 disables it.
# Runs inside SLEEP_WINDOW_UTC (or the small hours if none is set), costs no X quota, and
# the transcripts are published raw at /dreams/<slug>.
BACKROOMS_TURNS=16


# ---- model gateway ----
# PPQ (https://api.ppq.ai) — pay-per-prompt, OpenAI-compatible wire format. Point this at
# api.openai.com or any other compatible gateway and nothing above the adapter changes.
LLM_BASE_URL=https://api.ppq.ai
LLM_API_KEY=

# Model ids move faster than this repo does, and a wrong one is a runtime 404.
# `pnpm doctor` lists exactly what this key can reach — set these from that list.
# Ids on a gateway are namespaced. PPQ gives you both families on one key, so the tiers
# are chosen rather than uniform:
#   voice  = what gets published. Claude holds a persona and a register best.
#   critic = a DIFFERENT family on purpose. A model judging its own output shares its
#            blind spots; an outsider is a real second opinion.
#   triage = the cheapest thing that can say yes or no. Runs on everything.
LLM_MODEL_VOICE=claude-sonnet-4.6
LLM_MODEL_CRITIC=openai/gpt-5.5
LLM_MODEL_TRIAGE=google/gemini-2.5-flash
LLM_MODEL_DREAM=claude-sonnet-4.6
LLM_MODEL_REFLECT=openai/gpt-5.5
LLM_MODEL_EMBED=openai/text-embedding-3-small

# ---- cadence ----
TICK_INTERVAL_MS=300000
TICK_JITTER_MS=90000
SLEEP_WINDOW_UTC=03:00-09:00

# ---- display ----
AWAKENED_AT=
WALLET_PUBKEY=
CONFESSION_SALT=change-me
